// Copy to Secrets.xcconfig (gitignored) to sync readings to your own Firebase project.
// Values come from Firebase console > Project settings > Your apps > iOS app.
PULSELOG_FIREBASE_PROJECT_ID = your-project-id
PULSELOG_FIREBASE_APP_ID = 1:000000000000:ios:0000000000000000
PULSELOG_FIREBASE_API_KEY = your-ios-api-key
PULSELOG_FIREBASE_SENDER_ID = 000000000000
